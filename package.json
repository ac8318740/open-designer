{
  "name": "open-designer-viewer",
  "version": "0.7.8",
  "description": "Local design loop for Claude Code and Pi: HTML drafts, design systems, and a local viewer.",
  "license": "MIT",
  "author": "ac8318740",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ac8318740/open-designer.git"
  },
  "homepage": "https://github.com/ac8318740/open-designer",
  "keywords": [
    "design",
    "design-system",
    "ui",
    "html",
    "viewer",
    "iterate",
    "local",
    "claude",
    "pi-package"
  ],
  "type": "module",
  "bin": {
    "open-designer": "launcher/serve.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/open-designer.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions/",
    "skills/",
    "launcher/",
    "viewer/dist/",
    ".claude-plugin/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:packed": "node scripts/check-packed.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "build:viewer": "npm --prefix viewer ci --no-audit --no-fund && npm --prefix viewer run build",
    "prepublishOnly": "node scripts/sync-version.mjs --check && npm run build:viewer",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
